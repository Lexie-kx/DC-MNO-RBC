{
  "stage": "R3-0",
  "role": "architecture_freeze_before_training",

  "research_question": {
    "r3_1a_vs_r3_1b": "Does a dimensionally/representation-valid physical interface improve model-level PDE-structured coupling when architecture and training capacity are matched?"
  },

  "backbone": {
    "name": "M6-FieldWiseEncoder-H4",
    "class": "FieldWiseFNO2d",
    "frozen": true,
    "same_checkpoint_between_arms": true,
    "prediction_type": "normalized_finite_step_delta"
  },

  "matched_pair": {
    "r3_1a": {
      "name": "Naive normalized-space PDE sparse coupling control",
      "representation_mode": "naive",
      "physical_interface": "identity_metadata"
    },
    "r3_1b": {
      "name": "Canonical dimension-valid PDE sparse coupling candidate",
      "representation_mode": "canonical",
      "physical_interface": "real_canonical_metadata"
    },

    "only_allowed_structural_difference": "physical_representation_interface"
  },

  "active_routing": {
    "buoyancy_advection": {
      "semantic_class": "cross_field",
      "sources": ["buoyancy", "u_x", "u_y"],
      "targets": ["buoyancy"],
      "active": true
    },

    "buoyancy_forcing": {
      "semantic_class": "cross_field",
      "sources": ["buoyancy"],
      "targets": ["u_y"],
      "active": true
    }
  },

  "registered_but_inactive": {
    "pressure_gradient": "R4 pressure-specific matched ablation",
    "momentum_advection": "R4 self-dynamics matched ablation",
    "viscosity": "R4 self-dynamics matched ablation",
    "buoyancy_diffusion": "R4 self-dynamics matched ablation"
  },

  "constraint_terms": {
    "divergence": {
      "output_injection": false,
      "role": "diagnostic_or_constraint_only"
    }
  },

  "correction": {
    "merge_space": "normalized_finite_step_target_delta",
    "phi": "identity",
    "gate_type": "global_learnable_bounded_scalar_per_active_term",
    "gate_formula": "alpha_j = alpha_max * tanh(raw_alpha_j)",
    "raw_gate_initialization": 0.0,
    "epoch0_output_equals_m6": true
  },

  "disabled_in_r3_1": {
    "stateparam": true,
    "utility_gate": true,
    "rmscap": true,
    "realized_dose_matching": true,
    "pde_loss": true,
    "learnable_spatial_phi": true,
    "legacy_m10_path_a": true
  },

  "future_stages": {
    "R3-2": "state-adaptive canonical coupling",
    "R3-3": "state-selective utility mechanism",
    "R4": "topology/PDE-semantics/self-dynamics/pressure matched ablations"
  }
}
